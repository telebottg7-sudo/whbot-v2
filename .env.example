# Telegram
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF...

# Optional: restrict bot to these user IDs (comma-separated). Leave empty = public
ALLOWED_USERS=

# Owner / admin (receives error reports)
BOT_OWNER_ID=7367490186

# Download settings
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=2
PREFERRED_QUALITY=1080p

# GoFile (optional – used when file > Telegram limit ~2GB)
GOFILE_TOKEN=

# WatchHentai
WATCHHENTAI_BASE_URL=https://watchhentai.net
